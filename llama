#!/usr/bin/env bash
# llama - unified launcher for llama-voice-assist
# Usage: ./llama <command>
#   setup  — create venv and install dependencies
#   cli    — launch terminal chatbot
#   web    — launch web UI (port 7860)
#   test   — run test suite

set -euo pipefail

SCRIPT_PATH="$(readlink -f "$0" 2>/dev/null || python3 -c "import os; print(os.path.realpath('$0'))")"
PROJECT_DIR="$(cd "$(dirname "$SCRIPT_PATH")" && pwd)"
VENV_DIR="$PROJECT_DIR/.venv"
PYTHON_BIN="python3.12"
REQUIREMENTS="$PROJECT_DIR/requirements.txt"

# ---------- colors ----------
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
BOLD='\033[1m'
RESET='\033[0m'

info()  { printf "${CYAN}[info]${RESET}  %s\n" "$*"; }
ok()    { printf "${GREEN}[ok]${RESET}    %s\n" "$*"; }
warn()  { printf "${YELLOW}[warn]${RESET}  %s\n" "$*"; }
err()   { printf "${RED}[error]${RESET} %s\n" "$*" >&2; }

# ---------- helpers ----------

ensure_python312() {
    if ! command -v "$PYTHON_BIN" &>/dev/null; then
        err "Python 3.12 is required but '$PYTHON_BIN' was not found."
        err "Install it via: brew install python@3.12"
        exit 1
    fi
}

ensure_venv() {
    if [ ! -d "$VENV_DIR" ]; then
        warn "Virtual environment not found at $VENV_DIR"
        info "Creating venv with $PYTHON_BIN ..."
        ensure_python312
        "$PYTHON_BIN" -m venv "$VENV_DIR"
        ok "venv created at $VENV_DIR"
        install_deps
    fi
}

activate_venv() {
    # shellcheck disable=SC1091
    source "$VENV_DIR/bin/activate"
}

install_deps() {
    info "Installing dependencies from requirements.txt ..."
    activate_venv
    pip install --upgrade pip -q
    pip install -r "$REQUIREMENTS"
    ok "Dependencies installed."
}

# ---------- commands ----------

cmd_setup() {
    info "Setting up llama-voice-assist ..."
    ensure_python312
    if [ -d "$VENV_DIR" ]; then
        warn "venv already exists at $VENV_DIR"
        info "Reinstalling dependencies ..."
        install_deps
    else
        info "Creating venv with $PYTHON_BIN ..."
        "$PYTHON_BIN" -m venv "$VENV_DIR"
        ok "venv created at $VENV_DIR"
        install_deps
    fi
    echo ""
    ok "Setup complete! Run 'llama cli' or 'llama web' to start."
}

cmd_cli() {
    ensure_venv
    activate_venv
    info "Launching CLI chatbot ..."
    echo ""
    python "$PROJECT_DIR/ms_llama.py" "$@"
}

cmd_web() {
    ensure_venv
    activate_venv
    info "Launching web UI on http://localhost:7860 ..."
    info "Configure model, API key, and persona in the browser"
    echo ""
    python "$PROJECT_DIR/interface/server.py" "$@"
}

cmd_test() {
    ensure_venv
    activate_venv
    info "Running tests ..."
    echo ""
    python -m pytest "$PROJECT_DIR/test_ms_llama.py" -v "$@"
}

cmd_help() {
    echo ""
    printf "${BOLD}llama-voice-assist${RESET} — local voice assistant launcher\n"
    echo ""
    printf "  ${BOLD}Usage:${RESET} llama <command>\n"
    echo ""
    printf "  ${BOLD}Commands:${RESET}\n"
    printf "    ${GREEN}setup${RESET}   Create Python 3.12 venv and install all dependencies\n"
    printf "    ${GREEN}cli${RESET}     Launch the terminal chatbot (select model, persona, TTS)\n"
    printf "    ${GREEN}web${RESET}     Launch the web UI with animated bubble on port 7860\n"
    printf "    ${GREEN}test${RESET}    Run the test suite with pytest\n"
    printf "    ${GREEN}help${RESET}    Show this help message\n"
    echo ""
    printf "  ${BOLD}First time?${RESET} Run ${CYAN}llama setup${RESET} first.\n"
    printf "  The venv is auto-created on first run if missing.\n"
    echo ""
}

# ---------- main ----------

COMMAND="${1:-help}"
shift 2>/dev/null || true

case "$COMMAND" in
    setup)  cmd_setup ;;
    cli)    cmd_cli "$@" ;;
    web)    cmd_web "$@" ;;
    test)   cmd_test "$@" ;;
    help|-h|--help) cmd_help ;;
    *)
        err "Unknown command: $COMMAND"
        cmd_help
        exit 1
        ;;
esac
