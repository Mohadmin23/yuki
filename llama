#!/usr/bin/env bash
# llama - unified launcher for llama-voice-assist
# Usage: ./llama <command>
#   setup  — create venv and install dependencies
#   cli    — launch terminal chatbot
#   tui    — launch TUI workspace (Odysseus-style)
#   web    — launch web UI (port 7860)
#   test   — run test suite

set -euo pipefail

SCRIPT_PATH="$(readlink -f "$0" 2>/dev/null || python3 -c "import os; print(os.path.realpath('$0'))")"
PROJECT_DIR="$(cd "$(dirname "$SCRIPT_PATH")" && pwd)"

# Centralize bytecode caches outside the source tree so __pycache__/ folders
# don't pollute the project (15 tool subfolders each generate their own).
# Scoped to this project via the path suffix.
export PYTHONPYCACHEPREFIX="${HOME}/.cache/pycache/llama-voice-assist"

# ---------- colors ----------
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
BOLD='\033[1m'
RESET='\033[0m'

info()  { printf "${CYAN}[info]${RESET}  %s\n" "$*"; }
ok()    { printf "${GREEN}[ok]${RESET}    %s\n" "$*"; }
warn()  { printf "${YELLOW}[warn]${RESET}  %s\n" "$*"; }
err()   { printf "${RED}[error]${RESET} %s\n" "$*" >&2; }

# ---------- helpers ----------

ensure_uv() {
    if ! command -v uv &>/dev/null; then
        err "uv is required but was not found."
        err "Install it via: brew install uv"
        exit 1
    fi
}

# ---------- commands ----------

cmd_setup() {
    info "Setting up llama-voice-assist with uv ..."
    ensure_uv
    (cd "$PROJECT_DIR" && uv sync)
    ok "Setup complete! Run 'llama cli' or 'llama web' to start."
}

cmd_cli() {
    ensure_uv
    info "Launching CLI chatbot ..."
    echo ""
    (cd "$PROJECT_DIR" && uv run python ms_llama.py "$@")
}

cmd_tui() {
    ensure_uv
    info "Launching TUI workspace ..."
    echo ""
    (cd "$PROJECT_DIR" && uv run python interface/tui.py "$@")
}

cmd_web() {
    ensure_uv
    info "Launching web UI on http://localhost:7860 ..."
    info "Configure model, API key, and persona in the browser"
    echo ""
    (cd "$PROJECT_DIR" && uv run python interface/server.py "$@")
}

cmd_test() {
    ensure_uv
    info "Running tests ..."
    echo ""
    (cd "$PROJECT_DIR" && uv run pytest tests/ -v "$@")
}

cmd_help() {
    echo ""
    printf "${BOLD}llama-voice-assist${RESET} — local voice assistant launcher\n"
    echo ""
    printf "  ${BOLD}Usage:${RESET} llama <command>\n"
    echo ""
    printf "  ${BOLD}Commands:${RESET}\n"
    printf "    ${GREEN}setup${RESET}   Run 'uv sync' to install all dependencies into .venv\n"
    printf "    ${GREEN}cli${RESET}     Launch the terminal chatbot (select model, persona, TTS)\n"
    printf "    ${GREEN}tui${RESET}     Launch the TUI workspace (sessions sidebar, markdown chat)\n"
    printf "    ${GREEN}web${RESET}     Launch the web UI with animated bubble on port 7860\n"
    printf "    ${GREEN}test${RESET}    Run the test suite with pytest\n"
    printf "    ${GREEN}help${RESET}    Show this help message\n"
    echo ""
    printf "  ${BOLD}First time?${RESET} Run ${CYAN}llama setup${RESET} first.\n"
    printf "  The venv is auto-created on first run if missing.\n"
    echo ""
}

# ---------- main ----------

COMMAND="${1:-help}"
shift 2>/dev/null || true

case "$COMMAND" in
    setup)  cmd_setup ;;
    cli)    cmd_cli "$@" ;;
    tui)    cmd_tui "$@" ;;
    web)    cmd_web "$@" ;;
    test)   cmd_test "$@" ;;
    help|-h|--help) cmd_help ;;
    *)
        err "Unknown command: $COMMAND"
        cmd_help
        exit 1
        ;;
esac
